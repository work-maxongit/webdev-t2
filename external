@import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400;700&family=Open+Sans:wght@300;400;600;700&display=swap');

body {
    font-family: 'Open Sans', sans-serif;
    line-height: 1.6;
    color: #0f172a; 
    background-color: #cbd5e1; 
    margin: 3vw; 
    padding: 0;
    overflow-wrap: break-word; 
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
}


header {
    background-color: #1e293b;
    color: #f8fafc;
    padding: 2.5rem 1rem;
    text-align: center;
    border-radius: 8px;
    margin-bottom: 20px;
}

h1 {
    font-size: 2.5rem;
    margin: 0;
    font-family: 'Merriweather', serif;
}

h2 {
    font-size: 2rem;
    border-bottom: 3px solid #3b82f6;
    padding-bottom: 10px;
    color: #1e293b;
    margin-top: 0;
    margin-bottom: 20px;
    font-family: 'Merriweather', serif;
}

h3 {
    font-size: 1.5rem;
    color: #334155;
    margin-bottom: 15px;
    margin-top: 0;
}

p, li, td, th, a {
    font-size: 1.1rem;
}

figcaption {
    font-size: 0.9rem;
    margin-top: 12px;
    font-style: italic;
    color: #475569;
}

nav {
    background-color: #34495e;
    padding: 1rem 0;
    text-align: center;
    border-radius: 8px;
    margin-bottom: 20px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #3b82f6;
}

main {
    max-width: 1200px;
    margin: 0 auto;
    background-color: transparent; 
    display: grid;
    grid-template-columns: 1fr 2.5fr; 
    gap: 25px; 
}

@media (max-width: 768px) {
    main {
        grid-template-columns: 1fr;
    }
}

figure#profile {
    text-align: center;
    background-color: #ffffff; 
    padding: 30px 20px;
    margin: 0;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    grid-column: 1 / 2; 
    grid-row: 1 / 4; 
    align-self: start;
}

figure img {
    width: 100%;
    max-width: 250px;
    height: auto; 
    border: 1px solid #ddd; 
    border-radius: 4px;
}

#details, #thought-process, #summary {
    background-color: #ffffff;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    grid-column: 2 / 3; 
}

#details {
    display: flex;
    flex-wrap: wrap;
    gap: 20px; 
}

section.list-column {
    flex: 1;
    min-width: 250px;
    margin: 0;
    background-color: #f8fafc; 
    padding: 15px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
}

ul {
    list-style-type: square;
    padding-left: 20px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
}

table, th, td {
    border: 1px solid #cbd5e1;
}

th, td {
    padding: 12px;
    text-align: left;
}

th {
    background-color: #1e293b;
    color: white;
    width: 30%;
}

footer {
    text-align: center;
    padding: 20px;
    background-color: #1e293b;
    color: white;
    margin-top: 40px;
    border-radius: 8px;
}

footer a {
    color: #3b82f6;
    text-decoration: none;
    margin: 0 10px;
}
